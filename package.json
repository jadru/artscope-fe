{
  "name": "ts-nextjs-tailwind-starter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "yarn start:local",
    "start:local": "yarn env-cmd -f .env.local next dev",
    "start:dev": "yarn env-cmd -f .env.development next dev",
    "start:prod": "serve -s .next -l 3000",
    "build:dev": "yarn env-cmd -f .env.development next build && yarn postbuild",
    "build:prod": "yarn env-cmd -f .env.production next build && yarn postbuild",
    "analyze": "yarn ANALYZE=true env-cmd -f .env.development next build",
    "lint": "next lint",
    "lint:fix": "eslint src --fix && yarn format",
    "lint:strict": "eslint --max-warnings=0 src",
    "typecheck": "tsc --noEmit --incremental false",
    "test:watch": "jest --watch",
    "test": "jest",
    "format": "prettier -w .",
    "format:check": "prettier -c .",
    "postbuild": "next-sitemap --config next-sitemap.config.js",
    "prepare": "husky install"
  },
  "dependencies": {
    "@ark-ui/react": "^1.0.1",
    "@cronitorio/cronitor-rum": "^0.4.1",
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@hocuspocus/provider": "^2.0.4",
    "@hookform/resolvers": "^3.0.0",
    "@mui/material": "^5.14.16",
    "@mui/x-charts": "^6.18.1",
    "@mui/x-date-pickers": "^6.17.0",
    "@nextui-org/react": "^2.2.9",
    "@tanstack/react-query": "^5.0.0",
    "@tiptap/extension-link": "^2.1.12",
    "@tiptap/extension-placeholder": "^2.1.12",
    "@tiptap/extension-underline": "^2.1.12",
    "@tiptap/pm": "^2.1.12",
    "@tiptap/react": "^2.1.12",
    "@tiptap/starter-kit": "^2.1.12",
    "@toss/lottie": "^1.1.10",
    "@toss/react": "^1.5.0",
    "@toss/utils": "^1.4.4",
    "axios": "^1.6.0",
    "chart.js": "^4.4.0",
    "clsx": "^1.2.1",
    "date-fns": "^2.30.0",
    "env-cmd": "^10.1.0",
    "framer-motion": "^10.16.4",
    "html-entities": "^2.4.0",
    "ics": "^3.5.0",
    "jwt-decode": "^3.1.2",
    "lodash": "^4.17.21",
    "next": "^14.0.2",
    "next-pwa": "^5.6.0",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.2.0",
    "react-cookies": "^0.1.1",
    "react-datepicker": "^4.20.0",
    "react-daum-postcode": "^3.1.3",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.43.9",
    "react-html-renderer": "^0.3.3",
    "react-icalendar-link": "^3.0.2",
    "react-icons": "^4.8.0",
    "react-intersection-observer": "^9.4.3",
    "react-lazy-load-image-component": "^1.5.6",
    "react-markdown": "^9.0.1",
    "react-query": "^3.39.3",
    "react-slideshow-image": "^4.3.0",
    "react-textarea-autosize": "^8.5.3",
    "react-toastify": "^9.1.2",
    "rehype-external-links": "^3.0.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.0",
    "sass": "^1.62.0",
    "strip-markdown": "^6.0.0",
    "supports-color": "8.1.1",
    "tailwind-merge": "^1.10.0",
    "tiptap-markdown": "^0.8.2",
    "url-metadata": "^3.3.0",
    "use-dehydrated-state": "^0.1.0",
    "use-local-storage": "^3.0.0",
    "uuid": "^9.0.0",
    "yup": "^1.0.2",
    "zustand": "^4.4.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^16.3.0",
    "@commitlint/config-conventional": "^16.2.4",
    "@next/bundle-analyzer": "^14.0.1",
    "@svgr/webpack": "^6.5.1",
    "@tanstack/eslint-plugin-query": "^5.0.0",
    "@tanstack/react-query-devtools": "^5.0.0",
    "@testing-library/jest-dom": "^6.1.4",
    "@testing-library/react": "^14.1.0",
    "@types/debug": "^4",
    "@types/identity-obj-proxy": "^3",
    "@types/jest": "^29.5.8",
    "@types/lodash": "^4.14.202",
    "@types/node": "^20.8.9",
    "@types/react": "^18.2.8",
    "@types/react-cookies": "^0.1.0",
    "@types/react-dom": "^18.2.4",
    "@types/uuid": "^9.0.1",
    "@typescript-eslint/eslint-plugin": "^5.56.0",
    "@typescript-eslint/parser": "^5.56.0",
    "autoprefixer": "^10.4.14",
    "eslint": "^8.51.0",
    "eslint-config-next": "^14.0.2",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-simple-import-sort": "^7.0.0",
    "eslint-plugin-unused-imports": "^2.0.0",
    "file-loader": "^6.2.0",
    "husky": "^7.0.4",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^12.5.0",
    "next-router-mock": "^0.7.5",
    "next-sitemap": "^4.2.3",
    "postcss": "^8.4.21",
    "prettier": "^2.8.7",
    "prettier-plugin-tailwindcss": "^0.1.13",
    "tailwindcss": "^3.3.3",
    "typescript": "^4.9.5"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx}": [
      "eslint --max-warnings=0",
      "prettier -w"
    ],
    "src/**/*.{css,scss,md,webmanifest}": [
      "prettier -w"
    ]
  },
  "packageManager": "yarn@4.0.0"
}
