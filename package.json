{
  "name": "artscope-fe",
  "packageManager": "yarn@4.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "packages/*/*"
  ],
  "scripts": {
    "core": "yarn workspace @artscope/core",
    "admin": "yarn workspace @artscope/admin",
    "lint": "eslint ./packages --ext .ts,.tsx,.js,.jsx --cache",
    "lint:fix": "eslint ./packages --fix && yarn format",
    "lint:strict": "eslint --max-warnings=0 ./packages",
    "typecheck": "yarn workspace @artscope/core typecheck",
    "format": "prettier -w ./packages",
    "format:check": "prettier -c ./packages",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@commitlint/cli": "^16.3.0",
    "@commitlint/config-conventional": "^16.2.4",
    "@cspell/eslint-plugin": "^8.8.1",
    "@next/eslint-plugin-next": "^14.2.3",
    "@types/node": "^18.18.2",
    "@typescript-eslint/eslint-plugin": "^7.8.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-refresh": "^0.4.7",
    "husky": "^8.0.3",
    "lint-staged": "^12.5.0",
    "prettier": "^3.2.5",
    "typescript": "^5.4.5"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx}": [
      "eslint --max-warnings=0",
      "prettier -w"
    ],
    "src/**/*.{css,scss,md,webmanifest}": [
      "prettier -w"
    ]
  },
  "dependencies": {
    "cookies-next": "^4.1.1"
  }
}
