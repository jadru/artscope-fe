{
  "name": "artscope-fe",
  "packageManager": "yarn@4.0.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "core": "yarn workspace @artscope/core",
    "admin": "yarn workspace @artscope/admin",
    "lint": "eslint ./packages --ext .ts,.tsx,.js,.jsx --cache",
    "lint:fix": "eslint src --fix && yarn format",
    "lint:strict": "eslint --max-warnings=0 src",
    "typecheck": "yarn workspace @artscope/core typecheck",
    "test:watch": "yarn workspace @artscope/core --watch",
    "test": "yarn workspace @artscope/core test",
    "format": "prettier -w .",
    "format:check": "prettier -c .",
    "prepare": "husky install"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.0.0",
    "axios": "^1.6.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^4.8.0",
    "react-query": "^3.39.3",
    "react-toastify": "^9.1.2",
    "sass": "^1.62.0",
    "uuid": "^9.0.0",
    "zustand": "^4.4.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^16.3.0",
    "@commitlint/config-conventional": "^16.2.4",
    "@tanstack/eslint-plugin-query": "^5.0.0",
    "@tanstack/react-query-devtools": "^5.0.0",
    "@testing-library/jest-dom": "^6.1.4",
    "@testing-library/react": "^14.1.0",
    "@types/node": "^18.18.2",
    "@types/react-dom": "^18.2.4",
    "@types/uuid": "^9.0.1",
    "@typescript-eslint/eslint-plugin": "^5.56.0",
    "eslint": "^8.51.0",
    "eslint-config-next": "^14.0.3",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-simple-import-sort": "^7.0.0",
    "eslint-plugin-unused-imports": "^2.0.0",
    "lint-staged": "^12.5.0",
    "postcss": "^8.4.21",
    "prettier": "^2.8.7",
    "prettier-plugin-tailwindcss": "^0.1.13",
    "tailwind-merge": "^1.10.0",
    "tailwindcss": "^3.3.3",
    "typescript": "^4.9.5"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx}": [
      "eslint --max-warnings=0",
      "prettier -w"
    ],
    "src/**/*.{css,scss,md,webmanifest}": [
      "prettier -w"
    ]
  }
}
